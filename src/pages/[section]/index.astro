---
/* /mentors/ — published only while "Show the Mentors page" is on (Keystatic → Site settings) */
import Base from '../../layouts/Base.astro';
import { getContent } from '../../lib/content';
import { SITE, TITLES, DESCRIPTIONS, breadcrumb, mentorsLd } from '../../lib/seo';

export async function getStaticPaths() {
  const { mentorsPage } = await getContent();
  return mentorsPage ? [{ params: { section: 'mentors' } }] : [];
}
const { mentors } = await getContent();
const list = mentors.filter((m) => m.listed).sort((a, b) => a.order - b.order || a.name.localeCompare(b.name));
---
<Base title={TITLES.mentors} description={DESCRIPTIONS.mentors} path="/mentors/"
  ld={[breadcrumb([['Home', SITE + '/'], ['Mentors', SITE + '/mentors/']]), mentorsLd(list)]}>
  <section class="page-head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a class="link" href="/">Home</a><span aria-hidden="true">/</span><span>Mentors</span></nav>
      <h1 class="page-title">Mentors</h1>
      <p class="page-lead">Composers, artists, designers and makers who teach the way they work. Meet the practitioners behind our workshops and talks, and see what each of them brings to the studio.</p>
      <div class="mt-grid" id="mentorGrid">
        {list.map((m) => (
          <article class="mt-card">
            <div class="mt-photo">{m.photo
              ? <img class="mt-img" loading="lazy" src={m.photo} alt={`Portrait of ${m.name}`}>
              : <div class="ph mt-ph"><span class="ph-text">No image</span></div>}</div>
            <div class="mt-body"><h3>{m.name}</h3><p class="mt-role">{m.role}</p>{m.short && <p class="mt-text">{m.short}</p>}</div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
