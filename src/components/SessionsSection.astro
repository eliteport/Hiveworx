---
/* "Explore our workshops and talks": three cards with All / Workshops / Talks filters (home and About) */
import type { Session } from '../lib/content';
import SessionCard from './SessionCard.astro';
import { langOf, href, tr } from '../lib/i18n';
interface Props { id: string; filtersId: string; sessions: Session[]; upcoming: string | null }
const { id, filtersId, sessions, upcoming } = Astro.props;
const lang = langOf(Astro.url);
const T = tr(lang);
---
<section class="edition" id={id}>
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="label">{T('Workshops & talks', 'Workshops e palestras')}</p>
        <h2>{T('Explore our workshops', 'Explora os nossos workshops')} <span class="v">{T('and talks.', 'e palestras.')}</span></h2>
      </div>
      <p>{T('Each edition is a temporary, themed experience: talks, workshop series, practical activities, mentors’ stories, a public exhibition and a community gathering.', 'Cada edição é uma experiência temporária e temática: palestras, séries de workshops, atividades práticas, histórias de mentores, uma exposição aberta ao público e um encontro da comunidade.')}</p>
    </div>
    <div class="filters" id={filtersId} data-card-filter role="group" aria-label={T('Filter by format', 'Filtrar por formato')}>
      <button class="filter" type="button" data-filter="all" aria-pressed="true">{T('All', 'Todos')}</button>
      <button class="filter" type="button" data-filter="workshop" aria-pressed="false">Workshops</button>
      <button class="filter" type="button" data-filter="talk" aria-pressed="false">{T('Talks', 'Palestras')}</button>
    </div>
    <div class="cls-grid">{sessions.map((s) => <SessionCard session={s} nextUp={s.slug === upcoming} />)}</div>
    <div class="cls-more"><a class="btn btn-primary" href={href('/workshops/', lang)}>{T('See all workshops', 'Ver todos os workshops')} <span class="arr">→</span></a></div>
  </div>
</section>
