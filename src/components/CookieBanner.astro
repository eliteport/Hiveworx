---
/* cookie consent: shown until a visitor chooses; reopened from "Cookie settings" in the footer */
---
<div class="cc" id="cookieBanner" role="region" aria-label="Cookie consent" hidden>
  <p class="cc-text">We use Google Analytics cookies to see how people use this site. Nothing is tracked unless you accept.</p>
  <div class="cc-btns">
    <button class="btn btn-ghost btn-sm" type="button" data-consent="denied">Decline</button>
    <button class="btn btn-primary btn-sm" type="button" data-consent="granted">Accept</button>
  </div>
</div>
