---
/* EN / PT switch (menu bar and footer): links to the same page in the other language.
   A violet pill slides to the chosen language before the page changes (public/js/site.js). */
import { langOf, href, stripLang } from '../lib/i18n';
interface Props { full?: boolean }   // footer: "English" / "Português" with a globe; menu bar: EN / PT
const { full = false } = Astro.props;
const lang = langOf(Astro.url);
const page = stripLang(Astro.url.pathname);
const opts = [
  { code: 'en', short: 'EN', name: 'English', hl: 'en' },
  { code: 'pt', short: 'PT', name: 'Português', hl: 'pt-PT' },
] as const;
---
<div class:list={['lang-switch', full && 'lang-switch-full']} data-lang-switch data-active={lang} role="group" aria-label={lang === 'pt' ? 'Idioma' : 'Language'}>
  {full && <svg class="ls-globe" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.3 3.6 5.1 3.6 8.5s-1.2 6.2-3.6 8.5c-2.4-2.3-3.6-5.1-3.6-8.5s1.2-6.2 3.6-8.5Z"/></svg>}
  <span class="ls-track">
    <span class="ls-thumb" aria-hidden="true"></span>
    {opts.map((o) => (
      <a href={href(page, o.code)} hreflang={o.hl} lang={o.hl} data-lang-set={o.code}
        aria-current={o.code === lang ? 'true' : undefined} aria-label={full ? undefined : o.name}>{full ? o.name : o.short}</a>
    ))}
  </span>
</div>
