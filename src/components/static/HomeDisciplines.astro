<!-- DISCIPLINES -->
<section id="disciplines">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="label">What you can study</p>
        <h2>Design in the <span class="v">widest</span> sense.</h2>
      </div>
      <p>Six fields, one approach: touch the material, try the process, understand the decisions behind it.</p>
    </div>

    <div class="disc">
      <a class="dcard" href="/workshops/">
        <svg class="glyph" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="22" cy="22" r="16"/><path d="M22 6v8M22 30v8M6 22h8M30 22h8"/><circle cx="22" cy="22" r="4"/></svg>
        <span class="go" aria-hidden="true">↗</span>
        <h3>Design Thinking</h3>
        <p>Observe, question, prototype and test. A way of solving problems you can use anywhere.</p>
      </a>
      <a class="dcard" href="/workshops/">
        <svg class="glyph" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="6" y="6" width="32" height="32"/><path d="M6 18h32M18 18v20"/><circle cx="29" cy="28" r="5"/></svg>
        <span class="go" aria-hidden="true">↗</span>
        <h3>Graphic Design</h3>
        <p>Typography, layout, print, visual identity and composition.</p>
      </a>
      <a class="dcard" href="/workshops/">
        <svg class="glyph" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 38 20 6h4l12 32M13 26h18"/></svg>
        <span class="go" aria-hidden="true">↗</span>
        <h3>Typography</h3>
        <p>From hand-made letters to digital tools. Create your own typeface.</p>
      </a>
      <a class="dcard" href="/workshops/">
        <svg class="glyph" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 22h4M10 14v16M16 8v28M22 16v12M28 10v24M34 18v8M40 22h0"/></svg>
        <span class="go" aria-hidden="true">↗</span>
        <h3>Sound + Visual</h3>
        <p>How sound and visuals connect to build identity, rhythm and atmosphere.</p>
      </a>
      <a class="dcard" href="/workshops/">
        <svg class="glyph" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><rect x="5" y="8" width="20" height="16"/><path d="m5 20 6-5 5 4 4-3 5 4M30 12h9M30 18h9M5 30h34M5 36h24"/></svg>
