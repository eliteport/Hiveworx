      <a class="dcard" href="/workshops/">
        <svg class="glyph" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M22 4 38 13v18L22 40 6 31V13Z"/><path d="M6 13l16 9 16-9M22 22v18"/></svg>
