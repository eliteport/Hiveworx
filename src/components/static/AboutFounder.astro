---
// copied from the one-page site; edit freely
// English and Portuguese side by side: T('English', 'Português')
import { langOf, href, tr } from '../../lib/i18n';
const lang = langOf(Astro.url);
const T = tr(lang);
const h = (p: string) => href(p, lang);
---
<section class="edition" id="founder">
  <div class="wrap founder">
    <figure class="portrait portrait-photo"><img src="/images/founder.webp" width="854" height="1100" alt={T("Black and white portrait of Temo K. Dolidze, founder of Hiveworx, smiling at the camera, in a dark shirt-jacket over a light T-shirt", "Retrato a preto e branco de Temo K. Dolidze, fundador da Hiveworx, a sorrir para a câmara, com uma sobrecamisa escura sobre uma T-shirt clara")}></figure>
    <div class="letter">
      <div class="letter-head"><p class="label">{T("From the founder", "Do fundador")}</p></div>
      <blockquote>
        <p class="letter-lead">{T("“The most useful things I learned didn’t come from a classroom. They came from people who had done the work and were willing to show how.”", "“As coisas mais úteis que aprendi não vieram de uma sala de aula. Vieram de pessoas que tinham feito o trabalho e estavam dispostas a mostrar como.”")}</p>
        <p>{T("Hiveworx is built around that idea. Our mentors are makers, designers, builders and entrepreneurs. They teach the way they worked: they show the work, share the doubt and explain the decision.", "A Hiveworx nasceu dessa ideia. Os nossos mentores são criadores, designers, construtores e empreendedores. Ensinam como trabalharam: mostram o trabalho, partilham as dúvidas e explicam as decisões.")}</p>
        <p>{T("You don’t need a diploma or a portfolio to join. Bring curiosity and a sense that design matters. The goal is not to graduate. The goal is to learn something new, get interested enough to continue, and carry something useful back into your life.", "Não precisas de diploma nem de portefólio para participar. Traz curiosidade e a sensação de que o design importa. O objetivo não é tirar um curso. O objetivo é aprender algo novo, ganhar interesse suficiente para continuar e levar algo útil para a tua vida.")}</p>
      </blockquote>
      <p class="sign"><span class="hand">Temo K. Dolidze</span><span>{T("Founder, Hiveworx", "Fundador, Hiveworx")}</span></p>
    </div>
  </div>
</section>
