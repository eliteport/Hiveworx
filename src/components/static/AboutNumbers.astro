---
// copied from the one-page site; edit freely
// English and Portuguese side by side: T('English', 'Português')
import { langOf, href, tr } from '../../lib/i18n';
const lang = langOf(Astro.url);
const T = tr(lang);
const h = (p: string) => href(p, lang);
---
<section id="numbers">
  <div class="wrap">
    <div class="stats">
      <div class="stat"><p class="stat-n"><span class="count" data-to="6">6</span></p><p class="stat-l">{T("design disciplines, from typography to sound", "disciplinas de design, da tipografia ao som")}</p></div>
      <div class="stat"><p class="stat-n"><span class="count" data-to="50">50</span><span class="unit">+</span></p><p class="stat-l">{T("workshops and talks held", "workshops e palestras realizados")}</p></div>
      <div class="stat"><p class="stat-n"><span>1k</span><span class="unit">+</span></p><p class="stat-l">{T("people who’ve made something with us", "pessoas que já criaram algo connosco")}</p></div>
      <div class="stat"><p class="stat-n"><span class="count" data-to="100">100</span><span class="unit">%</span></p><p class="stat-l">{T("of sessions led by practitioners", "das sessões orientadas por profissionais")}</p></div>
    </div>
  </div>
</section>
