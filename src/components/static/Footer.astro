---
// copied from the one-page site; edit freely
import { langOf, href, tr } from '../../lib/i18n';
import LangSwitch from '../LangSwitch.astro';
const lang = langOf(Astro.url);
const T = tr(lang);
const h = (p: string) => href(p, lang);
---
<footer>
  <div class="wrap">
    <div class="f-grid">
      <div class="f-brand">
        <a class="logo" href={h("/")} aria-label={T("Hiveworx home", "Hiveworx, página inicial")}><svg viewBox="0 0 899 144" aria-hidden="true"><use href="#logo"/></svg></a>
        <p>{T("Experience-based design school. Real practitioners, hands-on learning, open to anyone.", "Escola de design baseada na experiência. Profissionais no ativo, aprendizagem prática e portas abertas a todos.")}</p>
        <span class="hand">{T("Lisbon, PT", "Lisboa, PT")}</span>
      </div>
      <div>
        <h4>Hiveworx</h4>
        <ul><li><a class="menu-link" href={h("/about/")}>{T("About", "Sobre")}</a></li><li><a class="menu-link" href={h("/#approach")}>{T("Philosophy", "Filosofia")}</a></li><li><a class="menu-link" href={h("/#program")}>{T("Upcoming workshop", "Próximo workshop")}</a></li><li><a class="menu-link" href={h("/workshops/")}>{T("Workshops & talks", "Workshops e palestras")}</a></li></ul>
      </div>
      <div>
        <h4>{T("Follow", "Segue-nos")}</h4>
        <ul><li><a class="menu-link f-social" href="https://www.instagram.com/hiveworx/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r=".6"/></svg>Instagram</a></li></ul>
      </div>
    </div>
    <div class="f-bottom"><span>© 2026 Hiveworx · hiveworx.com</span>
      <!-- light / dark switch: public/js/site.js keeps aria-pressed in sync with the saved choice -->
      <div class="f-switches">
      <LangSwitch />
      <div class="theme-switch" role="group" aria-label={T("Colour theme", "Tema de cores")}>
        <button type="button" data-theme-set="light" aria-pressed="false" aria-label={T("Light", "Claro")} title={T("Light", "Claro")}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg></button>
        <button type="button" data-theme-set="dark" aria-pressed="true" aria-label={T("Dark", "Escuro")} title={T("Dark", "Escuro")}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg></button>
      </div>
      </div>
      <span>hello@hiveworx.com · <a class="link" href={h("/privacy/")}>{T("Privacy", "Privacidade")}</a> · <button class="linkbtn cc-open" type="button" id="cookieSettings">{T("Cookie settings", "Definições de cookies")}</button></span></div>
  </div>
</footer>
