<footer>
  <div class="wrap">
    <div class="f-grid">
      <div class="f-brand">
        <a class="logo" href="/" aria-label="Hiveworx home"><svg viewBox="0 0 899 144" aria-hidden="true"><use href="#logo"/></svg></a>
        <p>Experience-based design school. Real practitioners, hands-on learning, open to anyone.</p>
        <span class="hand">Lisbon, PT</span>
      </div>
      <div>
        <h4>Hiveworx</h4>
        <ul><li><a class="menu-link" href="/about/">About</a></li><li><a class="menu-link" href="/#approach">Philosophy</a></li><li><a class="menu-link" href="/#program">Upcoming workshop</a></li><li><a class="menu-link" href="/workshops/">Workshops &amp; talks</a></li></ul>
      </div>
      <div>
        <h4>Follow</h4>
        <ul><li><a class="menu-link f-social" href="https://www.instagram.com/hiveworx/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r=".6"/></svg>Instagram</a></li></ul>
      </div>
    </div>
    <div class="f-bottom"><span>© 2026 Hiveworx · hiveworx.com</span>
      <!-- light / dark switch: public/js/site.js keeps aria-pressed in sync with the saved choice -->
      <div class="theme-switch" role="group" aria-label="Colour theme">
        <button type="button" data-theme-set="light" aria-pressed="true"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>Light</button>
        <button type="button" data-theme-set="dark" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg>Dark</button>
      </div>
      <span>hello@hiveworx.com · <a class="link" href="/privacy/">Privacy</a> · <button class="linkbtn cc-open" type="button" id="cookieSettings">Cookie settings</button></span></div>
  </div>
</footer>
