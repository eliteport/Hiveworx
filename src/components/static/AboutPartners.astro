---
// copied from the one-page site; edit freely
// English and Portuguese side by side: T('English', 'Português')
import { langOf, href, tr } from '../../lib/i18n';
const lang = langOf(Astro.url);
const T = tr(lang);
const h = (p: string) => href(p, lang);
---
<section id="partners">
  <div class="wrap">
    <div class="sec-head">
      <div><p class="label">{T("Partners", "Parceiros")}</p><h2><Fragment set:html={T("Supported by people who <span class=\"v\">back creative education.</span>", "Apoiada por quem <span class=\"v\">acredita na educação criativa.</span>")} /></h2></div>
    </div>
    <!-- partner logos: hidden until the real logos are ready -->
    <ul class="p-grid" aria-label={T("Partner logos (placeholders)", "Logótipos dos parceiros (provisórios)")} hidden><li class="p-tile"><svg viewBox="0 0 120 44" aria-hidden="true"><path d="M14 22 21 10h12l7 12-7 12H21Z"/><path d="M52 18h54M52 27h36"/></svg></li><li class="p-tile"><svg viewBox="0 0 120 44" aria-hidden="true"><path d="M14 22 21 10h12l7 12-7 12H21Z"/><path d="M52 18h54M52 27h36"/></svg></li><li class="p-tile"><svg viewBox="0 0 120 44" aria-hidden="true"><path d="M14 22 21 10h12l7 12-7 12H21Z"/><path d="M52 18h54M52 27h36"/></svg></li><li class="p-tile"><svg viewBox="0 0 120 44" aria-hidden="true"><path d="M14 22 21 10h12l7 12-7 12H21Z"/><path d="M52 18h54M52 27h36"/></svg></li><li class="p-tile"><svg viewBox="0 0 120 44" aria-hidden="true"><path d="M14 22 21 10h12l7 12-7 12H21Z"/><path d="M52 18h54M52 27h36"/></svg></li><li class="p-tile"><svg viewBox="0 0 120 44" aria-hidden="true"><path d="M14 22 21 10h12l7 12-7 12H21Z"/><path d="M52 18h54M52 27h36"/></svg></li></ul>
    <div class="p-cta"><a class="btn btn-ghost" href={h("/#contact")} data-who="Funder">{T("Partner with us", "Torna-te parceiro")} <span class="arr">→</span></a></div>
  </div>
</section>
