---
<!-- HERO -->
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="hero-loc hand">Lisbon, PT
        <svg width="18" height="22" viewBox="0 0 18 22" aria-hidden="true"><path d="M9 21s7-7 7-12A7 7 0 0 0 2 9c0 5 7 12 7 12Z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="9" cy="9" r="2.4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
      </div>
      <h1>Experience&#8209;based <span class="line2">design school</span></h1>
      <p class="hero-lead">A hands-on design school where <strong>real practitioners, not professors</strong>, teach through their own lived experience. Gain the tools and confidence to think, make, and see the world differently.</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="/workshops/">Explore workshops &amp; talks <span class="arr">→</span></a>
        <a class="btn btn-ghost" href="/#contact" data-who="Mentor">Become a mentor</a>
      </div>
    </div>

    <div class="hero-art hero-sketch">
      <img src="/images/hero-sketch.webp" width="1025" height="1089" fetchpriority="high" alt="Hand-drawn sketch of the Hiveworx studio: steel-framed glass wall, exposed ceiling beams, a round window and a worktable, with notes like Transparency connects people and ideas, Detail matters, Simple tools big ideas, Make ideate learn and Good spaces spark better thinking.">
    </div>
  </div>

  <div class="marquee" aria-label="What happens at Hiveworx">
    <div class="marquee-track">
      <span>Talks</span><span>Workshops</span><span>Demonstrations</span><span>Hands-on experiments</span><span>Exhibitions</span><span>Real life activities</span>
      <span aria-hidden="true">Talks</span><span aria-hidden="true">Workshops</span><span aria-hidden="true">Demonstrations</span><span aria-hidden="true">Hands-on experiments</span><span aria-hidden="true">Exhibitions</span><span aria-hidden="true">Real life activities</span>
    </div>
  </div>
</section>
