---
// copied from the one-page site; edit freely
// English and Portuguese side by side: T('English', 'Português')
import { langOf, href, tr } from '../../lib/i18n';
const lang = langOf(Astro.url);
const T = tr(lang);
const h = (p: string) => href(p, lang);
const words = T(
  ['Talks', 'Workshops', 'Demonstrations', 'Hands-on experiments', 'Exhibitions', 'Real life activities'],
  ['Palestras', 'Workshops', 'Demonstrações', 'Experiências práticas', 'Exposições', 'Atividades reais'],
);
---
<!-- HERO -->
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="hero-loc hand">{T("Lisbon, PT", "Lisboa, PT")}
        <svg width="18" height="22" viewBox="0 0 18 22" aria-hidden="true"><path d="M9 21s7-7 7-12A7 7 0 0 0 2 9c0 5 7 12 7 12Z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="9" cy="9" r="2.4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
      </div>
      <h1><Fragment set:html={T("Experience&#8209;based <span class=\"line2\">design school</span>", "Escola de design <span class=\"line2\">baseada na experiência</span>")} /></h1>
      <p class="hero-lead"><Fragment set:html={T("A hands-on design school where <strong>real practitioners</strong> teach through their own lived experience. Gain the tools and confidence to think, make, and see the world differently.", "Uma escola de design prática onde <strong>profissionais no ativo</strong> ensinam a partir da sua própria experiência. Ganha as ferramentas e a confiança para pensar, criar e ver o mundo de outra forma.")} /></p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href={h("/workshops/")}>{T("Explore workshops & talks", "Explorar workshops e palestras")} <span class="arr">→</span></a>
        <a class="btn btn-ghost" href={h("/#contact")} data-who="Mentor">{T("Become a mentor", "Ser mentor")}</a>
      </div>
    </div>

    <div class="hero-art hero-sketch">
      <img src="/images/hero-sketch.webp" width="1025" height="1089" fetchpriority="high" alt={T("Hand-drawn sketch of the Hiveworx studio: steel-framed glass wall, exposed ceiling beams, a round window and a worktable, with notes like Transparency connects people and ideas, Detail matters, Simple tools big ideas, Make ideate learn and Good spaces spark better thinking.", "Esboço desenhado à mão do estúdio da Hiveworx: parede de vidro com caixilhos de aço, vigas do teto à vista, uma janela redonda e uma mesa de trabalho, com notas como Transparency connects people and ideas, Detail matters, Simple tools big ideas, Make ideate learn e Good spaces spark better thinking.")}>
    </div>
  </div>

  <div class="marquee" aria-label={T("What happens at Hiveworx", "O que acontece na Hiveworx")}>
    <div class="marquee-track">
      {words.map((w) => <span>{w}</span>)}
      {words.map((w) => <span aria-hidden="true">{w}</span>)}
    </div>
  </div>
</section>
