---
/* Every page: head (title, description, share tags, structured data), menu, footer, scripts. */
import Sprite from '../components/static/Sprite.astro';
import Nav from '../components/Nav.astro';
import Lightbox from '../components/static/Lightbox.astro';
import Footer from '../components/static/Footer.astro';
import { SITE, abs, ORG, DEFAULT_IMAGE } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;              // e.g. "/workshops/lets-touchdesign/"
  image?: string;            // share image, site-relative
  ld?: object[];             // extra structured data next to the organisation
  noindex?: boolean;
}
const { title, description, path, image = DEFAULT_IMAGE, ld = [], noindex = false } = Astro.props;
const url = SITE + path;
const graph = JSON.stringify({ '@context': 'https://schema.org', '@graph': [ORG, ...ld] }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
{noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={url}>}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Hiveworx">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content={abs(image)}>
<meta property="og:locale" content="en_GB">
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json" set:html={graph} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@300..700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@300..700&family=Caveat:wght@500;700&display=swap">
<link rel="stylesheet" href="/css/styles.css">
<script is:inline defer src="https://cdn.jsdelivr.net/npm/lenis@1.3.15/dist/lenis.min.js"></script>
</head>
<body>
<Sprite />
<Nav />
<main id="top">
<slot />
</main>
<Lightbox />
<Footer />
<script is:inline src="/js/site.js"></script>
<script is:inline defer src="/js/motion.js"></script>
</body>
</html>
